#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(node -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

STATE="${PRIME_AGENT_SAIL_CODING_AGENT_DIR:-$HOME/.prime-agent-sail}"
export PRIME_AGENT_SAIL_CODING_AGENT_DIR="$STATE"
export PRIME_AGENT_CODING_AGENT_DIR="$STATE"
export PRIME_AGENT_KERNEL_VENV="$STATE/kernel-venv"
unset PRIME_AGENT_KERNEL_PYTHON
export PRIME_AGENT_INTERNAL_DAEMON_SUPERVISOR_REGISTRY_DIR="$STATE/supervisor-owners"
# Daemon sockets use the temp directory, independently of the app's config directory.
export TMPDIR="$STATE/tmp"
export PI_PACKAGE_DIR="$SCRIPT_DIR/packages/coding-agent"
export TSX_TSCONFIG_PATH="$SCRIPT_DIR/tsconfig.json"
export PRIME_AGENT_LAUNCHER_PATH="$SCRIPT_DIR/prime-agent-sail"
umask 077
mkdir -p "$TMPDIR"

if [[ ! -x "$SCRIPT_DIR/node_modules/.bin/tsx" ]]; then
  echo "Run npm ci in $SCRIPT_DIR first." >&2
  exit 1
fi

exec "$SCRIPT_DIR/node_modules/.bin/tsx" "$SCRIPT_DIR/packages/coding-agent/src/cli.ts" "$@"
